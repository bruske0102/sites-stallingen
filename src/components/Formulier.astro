---
// Web3Forms + hCaptcha (same pattern as kostenstoffeerder).
interface Veld {
  naam: string;
  label: string;
  type?: string;
  verplicht?: boolean;
  hint?: string;
  auto?: string;
}
interface Props {
  id: string;
  onderwerp: string;
  velden: Veld[];
  knop: string;
}
const { id, onderwerp, velden, knop } = Astro.props;
import { instellingen } from "../lib/data";
const key = import.meta.env.PUBLIC_WEB3FORMS_KEY || instellingen.web3forms?.key || "";
---
<form class="form" id={id} action="https://api.web3forms.com/submit" method="POST" data-web3form data-pagefind-ignore>
  <input type="hidden" name="access_key" value={key} />
  <input type="hidden" name="subject" value={onderwerp} />
  <input type="hidden" name="from_name" value={instellingen.site.naam} />
  <input type="checkbox" name="botcheck" class="skip" tabindex="-1" autocomplete="off" aria-hidden="true" />
  {velden.map((v) => (
    <label for={`${id}-${v.naam}`}>
      {v.label}{v.verplicht && " *"}
      {v.type === "textarea"
        ? <textarea id={`${id}-${v.naam}`} name={v.naam} required={v.verplicht}></textarea>
        : <input id={`${id}-${v.naam}`} name={v.naam} type={v.type ?? "text"} required={v.verplicht} autocomplete={v.auto} />}
      {v.hint && <span class="hint">{v.hint}</span>}
    </label>
  ))}
  <div class="h-captcha" data-captcha="true"></div>
  <button class="btn" type="submit">{knop}</button>
  <div class="notice" role="status" aria-live="polite" hidden data-melding></div>
  {!key && (
    <p class="notice err">
      Formulier nog niet gekoppeld (zet <code>PUBLIC_WEB3FORMS_KEY</code> in Cloudflare Pages / .env).
      Lokaal kun je de velden bekijken; versturen werkt pas met een echte key.
    </p>
  )}
</form>
<script is:inline src="https://web3forms.com/client/script.js" async defer></script>
<script>
  // Same flow as Web3Forms docs (fetch + FormData + access_key), with Dutch UI + hCaptcha.
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-web3form]")) {
    const melding = form.querySelector<HTMLElement>("[data-melding]")!;
    const knop = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const toon = (ok: boolean, tekst: string) => {
      melding.hidden = false;
      melding.className = "notice " + (ok ? "ok" : "err");
      melding.textContent = tekst;
    };
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const accessKey = formData.get("access_key") || form.dataset.accessKey || "";
      if (!accessKey) {
        return toon(false, "Formulier is nog niet gekoppeld (access key ontbreekt).");
      }
      if (!formData.get("access_key")) formData.append("access_key", String(accessKey));
      if (!formData.get("h-captcha-response")) {
        return toon(false, "Vink eerst de controle aan (ik ben geen robot).");
      }
      const originalText = knop.textContent;
      knop.textContent = "Versturen…";
      knop.disabled = true;
      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: formData,
        });
        const data = await response.json();
        if (response.ok && data.success) {
          form.reset();
          toon(true, "Bedankt! Je bericht is verstuurd. We reageren zo snel mogelijk.");
        } else {
          toon(false, "Versturen lukte niet: " + (data.message || "onbekende fout") + ". Probeer het later opnieuw.");
        }
      } catch {
        toon(false, "Er ging iets mis. Controleer je verbinding en probeer het opnieuw.");
      } finally {
        knop.textContent = originalText;
        knop.disabled = false;
      }
    });
  }
</script>
