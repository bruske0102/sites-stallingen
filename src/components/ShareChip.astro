---
/**
 * Soft WhatsApp / native share prompt.
 * Not a first-paint interstitial - delayed, dismissible, once per session.
 */
interface Props {
  /** Override share text; defaults to document title + URL client-side. */
  label?: string;
}
const { label = "Deel deze pagina" } = Astro.props;
---
<aside
  id="share-chip"
  class="share-chip"
  hidden
  role="complementary"
  aria-label="Pagina delen"
  data-share-chip
>
  <button type="button" class="share-chip__action" data-share-action>
    <span class="share-chip__icon" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.5 14.2c-.4 0-.8.1-1.1.3l-4.1-2.4c.1-.3.2-.6.2-.9s-.1-.6-.2-.9l4.1-2.4c.3.2.7.3 1.1.3 1.2 0 2.2-1 2.2-2.2S18.7 4 17.5 4s-2.2 1-2.2 2.2c0 .3.1.6.2.9L11.4 9.5c-.3-.2-.7-.3-1.1-.3-1.2 0-2.2 1-2.2 2.2s1 2.2 2.2 2.2c.4 0 .8-.1 1.1-.3l4.1 2.4c-.1.3-.2.6-.2.9 0 1.2 1 2.2 2.2 2.2s2.2-1 2.2-2.2-1-2.2-2.2-2.2z"/>
      </svg>
    </span>
    <span class="share-chip__label">{label}</span>
  </button>
  <button
    type="button"
    class="share-chip__close"
    data-share-dismiss
    aria-label="Sluiten"
  >×</button>
</aside>

<script>
  const KEY = "ko-share-dismissed";
  const DELAY_MS = 9000;
  const SCROLL_PCT = 0.4;

  function ready() {
    const el = document.querySelector("[data-share-chip]");
    if (!(el instanceof HTMLElement)) return;
    if (sessionStorage.getItem(KEY) === "1") return;

    let shown = false;
    const show = () => {
      if (shown || sessionStorage.getItem(KEY) === "1") return;
      shown = true;
      el.hidden = false;
      cleanup();
    };

    const onScroll = () => {
      const doc = document.documentElement;
      const max = doc.scrollHeight - window.innerHeight;
      if (max <= 0) return;
      if (window.scrollY / max >= SCROLL_PCT) show();
    };

    const timer = window.setTimeout(show, DELAY_MS);
    window.addEventListener("scroll", onScroll, { passive: true });

    function cleanup() {
      window.clearTimeout(timer);
      window.removeEventListener("scroll", onScroll);
    }

    el.querySelector("[data-share-dismiss]")?.addEventListener("click", () => {
      sessionStorage.setItem(KEY, "1");
      el.hidden = true;
      cleanup();
    });

    el.querySelector("[data-share-action]")?.addEventListener("click", async () => {
      const title = document.title || "Stallingen.xyz";
      const url = location.href;
      const text = `${title}\n${url}`;
      const canNative =
        typeof navigator.share === "function" &&
        (/Mobi|Android|iPhone|iPad/i.test(navigator.userAgent) ||
          (navigator as Navigator & { userAgentData?: { mobile?: boolean } }).userAgentData
            ?.mobile === true);

      if (canNative) {
        try {
          await navigator.share({ title, text: title, url });
          sessionStorage.setItem(KEY, "1");
          el.hidden = true;
          return;
        } catch {
          /* user cancel or unsupported - fall through to WhatsApp */
        }
      }

      const wa = `https://wa.me/?text=${encodeURIComponent(text)}`;
      window.open(wa, "_blank", "noopener,noreferrer");
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", ready);
  } else {
    ready();
  }
</script>
